PORT=8000
# Local Homebrew Postgres often uses your macOS username with no password:
# DATABASE_URL=postgresql://YOUR_USER@localhost:5432/healthcare
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
